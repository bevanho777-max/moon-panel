# Moon Panel — example Docker Compose deployment.
#
# Usage:
#   1. Copy this file to docker-compose.yml in the same directory.
#   2. Edit MOON_ADMIN_PASSWORD to something strong (≥ 8 chars enforced;
#      ≥ 14 with mixed case + digits is recommended for public exposure).
#   3. Adjust PUID / PGID to match the host user that should own ./data/.
#   4. PUID=$(id -u) PGID=$(id -g) docker compose up -d --build
#   5. Open http://localhost:3000 and log in as admin.
#
# After first login, comment out MOON_ADMIN_PASSWORD — it's only consulted
# while the users table is empty.

services:
  moon-panel:
    # Build from source for now. After the v0.1.0 release ships, replace
    # the `build:` line with:
    #     image: ghcr.io/bevanho777-max/moon-panel:latest
    # and drop `build: .` so you pull the published multi-arch image
    # instead of compiling locally.
    build: .
    image: moon-panel:latest
    container_name: moon-panel
    restart: unless-stopped
    ports:
      # host:container — change the host side if 3000 is busy on your box.
      - "3000:3000"
    environment:
      # ─── Host user mapping ─────────────────────────────────────────
      # Files written under ./data/ end up owned by this UID/GID.
      #   - Generic Linux:  PUID=1000  PGID=1000  (default desktop user)
      #   - Synology DSM:   PUID=1026  PGID=100   ("users" group)
      #   - Unraid:         PUID=99    PGID=100   ("nobody"/"users")
      #   - TrueNAS Scale:  match the dataset owner you mounted from
      PUID: ${PUID:-1000}
      PGID: ${PGID:-1000}

      # ─── Core operation ────────────────────────────────────────────
      # Sets gin to release mode and silences SQL query logs. Always
      # "production" for deployed instances. (Dev uses "development".)
      MOON_ENV: production

      # public_mode=true (default): home page reachable without login,
      # only /admin requires auth.
      # public_mode=false: gates the entire site behind login.
      MOON_PUBLIC_MODE: "false"

      # ─── First-run admin bootstrap ─────────────────────────────────
      # Used ONLY while the users table is empty. After the first admin
      # account exists, this variable is silently ignored — changing it
      # and restarting will not change the password.
      #
      # Change password later: log in → admin dropdown (top-right) →
      #   Change Password.
      # Recover a lost password:
      #   docker compose exec moon-panel \
      #     sqlite3 /data/moon.db 'DELETE FROM users WHERE username="admin";'
      #   docker compose restart moon-panel
      #   (the value below is then re-bootstrapped)
      #
      # Safety: ≥ 8 characters enforced by the backend; ≥ 14 with mixed
      # character classes recommended for public deployments.
      MOON_ADMIN_PASSWORD: changeme

      # ─── Optional knobs (uncomment to use) ─────────────────────────

      # Listen port inside the container. Rarely changed — adjust the
      # `ports:` mapping above instead if you want a different host port.
      # Default: 3000.
      # MOON_PORT: "3000"

      # Where SQLite db, uploads/, and jwt.key live INSIDE the container.
      # Should match the right side of the volume mount below.
      # Default: /data.
      # MOON_DATA_DIR: /data

      # Default session lifetime in days when "remember me" is NOT checked.
      # Default: 7. Recommended: 7 for shared/public, 30 for personal-only.
      # MOON_TOKEN_TTL_DAYS: "7"

      # Session lifetime in days when "remember me" IS checked at login.
      # Default: 30.
      # MOON_TOKEN_REMEMBER_TTL_DAYS: "30"

      # Set "true" only when the cookie is delivered over HTTPS, otherwise
      # browsers reject the Secure flag and login silently fails.
      # Default: false.
      # MOON_COOKIE_SECURE: "true"

      # Reverse-proxy CORS origin. Leave empty (default) for same-origin
      # deployments. Set when serving the panel under a different host
      # than the API (uncommon for personal panels).
      # MOON_CORS_ORIGINS: https://panel.example.com

      # CIDRs whose X-Forwarded-For / X-Forwarded-Proto headers are
      # trusted. Default: "127.0.0.1,172.16.0.0/12" — covers loopback
      # plus the entire Docker default bridge range. Add your reverse-
      # proxy's IP/CIDR if it sits outside that range.
      # MOON_TRUSTED_PROXIES: 127.0.0.1,172.16.0.0/12

      # JWT secret. If unset, one is auto-generated on first start and
      # persisted to data/jwt.key (so existing sessions survive restart).
      # Override only if you want to externalise it (e.g. mount from a
      # secret manager). Min 32 chars.
      # MOON_JWT_SECRET: ...

      # SSRF defense for the icon-fetch endpoint:
      #   - allow_private_fetch defaults to false (refuse 10.x, 172.16/12,
      #     192.168.x, link-local, loopback).
      #   - allowed_fetch_hosts is an optional comma-separated allowlist;
      #     when set, only listed hosts may be fetched.
      # MOON_ALLOW_PRIVATE_FETCH: "false"
      # MOON_ALLOWED_FETCH_HOSTS: cdn.example.com,icons.example.org

    volumes:
      # SQLite db + uploads/ (icons + wallpapers) + jwt.key all live here.
      # Back this directory up — everything else is rebuilt from source
      # on container restart and recovers without state.
      - ./data:/data
